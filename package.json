{
  "name": "wxbot",
  "version": "0.1.2",
  "description": "Conversational weather assistant CLI for any OpenAI-compatible backend.",
  "keywords": [
    "weather",
    "cli",
    "openai",
    "llm",
    "open-meteo",
    "chatbot"
  ],
  "homepage": "https://github.com/ernilambar/wxbot#readme",
  "bugs": {
    "url": "https://github.com/ernilambar/wxbot/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ernilambar/wxbot.git"
  },
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "wxbot": "./src/index.js"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "mkdir -p dist && bun build --compile --minify ./src/index.js --outfile dist/wxbot",
    "build:mac": "mkdir -p dist && bun build --compile --target=bun-darwin-arm64 --minify ./src/index.js --outfile dist/wxbot-darwin-arm64 && bun build --compile --target=bun-darwin-x64 --minify ./src/index.js --outfile dist/wxbot-darwin-amd64",
    "format": "eslint --fix .",
    "lint": "eslint .",
    "start": "bun src/index.js",
    "test": "bun test"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "openai": "^7.13.0",
    "ora": "^9.4.1",
    "string-width": "^7.2.0",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "neostandard": "^0.13.0"
  },
  "engines": {
    "bun": ">=1.2",
    "node": ">=22"
  }
}
